# Keep source and text fixtures byte-stable on every CI runner. Some tests hash
# fixture bytes, and raw string literals in the Base-14 metrics require a
# consistent newline convention.
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
tests/fixtures/cmaps/* text eol=lf

# This generated ASCII-heavy PDF is hashed byte-for-byte by the test suite.
tests/fixtures/rendering-transparency.pdf text eol=lf
tests/fixtures/annotations-alpha1.pdf text eol=lf
tests/fixtures/acroform-alpha2.pdf text eol=lf
tests/fixtures/optional-content-alpha3.pdf text eol=lf
tests/fixtures/annotations-beta1.pdf text eol=lf
tests/fixtures/robustness-beta2.pdf text eol=lf
tests/fixtures/outline-alpha1.pdf text eol=lf
