@page "/"
@implements IDisposable
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Poppler.Net Playground · PDF nel browser</PageTitle>

<div class="app-shell">
    <header class="topbar">
        <a class="brand" href="" aria-label="Poppler.Net Playground">
            <span class="brand-mark" aria-hidden="true">
                <span></span><span></span><span></span>
            </span>
            <span>
                <strong>Poppler.Net</strong>
                <small>WebAssembly playground</small>
            </span>
        </a>
        <div class="topbar-actions">
            <span class="privacy-pill"><i></i> Elaborazione locale</span>
            <a class="github-link" href="https://github.com/MiLattanzio/Poppler.Net" target="_blank" rel="noreferrer">
                GitHub <span aria-hidden="true">↗</span>
            </a>
        </div>
    </header>

    <main>
        <section class="hero">
            <div>
                <p class="eyebrow">Managed PDF engine · @Document.PortVersion</p>
                <h1>Apri il PDF.<br /><em>Guarda dentro.</em></h1>
                <p class="hero-copy">
                    Renderizza, estrai e ispeziona un documento con la stessa API .NET di Poppler.Net,
                    eseguita interamente nel browser tramite WebAssembly.
                </p>
            </div>
            <div class="hero-stats" aria-label="Caratteristiche">
                <div><strong>0</strong><span>upload al server</span></div>
                <div><strong>3</strong><span>renderer HTML + PNG + SVG</span></div>
                <div><strong>100%</strong><span>codice gestito</span></div>
            </div>
        </section>

        <section class="workspace">
            <aside class="control-panel">
                <div class="panel-heading">
                    <div>
                        <p class="step">01 · Documento</p>
                        <h2>Scegli un PDF</h2>
                    </div>
                    @if (_document is not null)
                    {
                        <span class="status-dot" title="Documento caricato"></span>
                    }
                </div>

                <label class="drop-zone @(_isBusy ? "disabled" : null)" for="pdf-file">
                    <InputFile id="pdf-file" OnChange="HandleFileAsync" accept="application/pdf,.pdf" disabled="@_isBusy" />
                    <span class="upload-icon" aria-hidden="true">↑</span>
                    @if (_fileName is null)
                    {
                        <strong>Trascina o seleziona</strong>
                        <small>PDF fino a @FormatBytes(MaxInputBytes)</small>
                    }
                    else
                    {
                        <strong title="@_fileName">@_fileName</strong>
                        <small>@FormatBytes(_fileSize) · scegli per sostituire</small>
                    }
                </label>
                <button type="button" class="sample-link" @onclick="LoadSampleAsync" disabled="@_isBusy">
                    Non hai un PDF? Apri il documento demo <span aria-hidden="true">→</span>
                </button>

                <details class="password-box" open="@(_document?.IsLocked == true)">
                    <summary>Password del documento <span>opzionale</span></summary>
                    <div class="password-fields">
                        <label>
                            Password utente
                            <input type="password" autocomplete="off" @bind="_userPassword" />
                        </label>
                        <label>
                            Password proprietario
                            <input type="password" autocomplete="off" @bind="_ownerPassword" />
                        </label>
                        <button type="button" class="button secondary full" @onclick="ReloadDocumentAsync" disabled="@(_selectedBytes is null || _isBusy)">
                            Apri con password
                        </button>
                    </div>
                </details>

                @if (_errorMessage is not null)
                {
                    <div class="notice error" role="alert">
                        <strong>Non è stato possibile continuare</strong>
                        <span>@_errorMessage</span>
                    </div>
                }
                else if (_document?.IsLocked == true)
                {
                    <div class="notice warning" role="status">
                        <strong>PDF protetto</strong>
                        <span>Inserisci la password corretta per accedere alle pagine.</span>
                    </div>
                }

                @if (_document is not null && !_document.IsLocked)
                {
                    <div class="document-card">
                        <div class="document-title">
                            <span class="mini-file" aria-hidden="true">PDF</span>
                            <div>
                                <strong>@DisplayTitle</strong>
                                <small>PDF @_document.PdfVersion · @_document.Pages pagine</small>
                            </div>
                        </div>
                        <dl>
                            <div><dt>Autore</dt><dd>@ValueOrDash(_document.Author)</dd></div>
                            <div><dt>Produttore</dt><dd>@ValueOrDash(_document.Producer)</dd></div>
                            <div><dt>Struttura</dt><dd>@(_document.IsLinearized ? "Linearizzato" : "Standard")</dd></div>
                            <div><dt>Cifratura</dt><dd>@(_document.IsEncrypted ? _document.PasswordKind.ToString() : "Nessuna")</dd></div>
                        </dl>
                        <button type="button" class="download-action full-width" @onclick="DownloadSourcePdfAsync" disabled="@(_selectedBytes is null || _isBusy)">
                            Scarica PDF originale
                        </button>
                    </div>

                    <div class="render-controls">
                        <p class="step">02 · Rendering</p>
                        <div class="segmented" role="group" aria-label="Formato anteprima">
                            <button type="button" class="@(_previewFormat == PreviewFormat.Html ? "active" : null)" @onclick="() => SetPreviewFormatAsync(PreviewFormat.Html)">HTML</button>
                            <button type="button" class="@(_previewFormat == PreviewFormat.Png ? "active" : null)" @onclick="() => SetPreviewFormatAsync(PreviewFormat.Png)">PNG</button>
                            <button type="button" class="@(_previewFormat == PreviewFormat.Svg ? "active" : null)" @onclick="() => SetPreviewFormatAsync(PreviewFormat.Svg)">SVG</button>
                        </div>
                        <div class="control-grid">
                            @if (_previewFormat == PreviewFormat.Png)
                            {
                                <label>
                                    Risoluzione
                                    <select @bind="_dpi">
                                        <option value="72">72 DPI</option>
                                        <option value="96">96 DPI</option>
                                        <option value="144">144 DPI</option>
                                        <option value="192">192 DPI</option>
                                    </select>
                                </label>
                                <label>
                                    Antialiasing
                                    <select @bind="_antialiasing">
                                        <option value="1">1×</option>
                                        <option value="2">2×</option>
                                        <option value="4">4×</option>
                                    </select>
                                </label>
                            }
                            else
                            {
                                <label>
                                    @(_previewFormat == PreviewFormat.Html ? "Scala HTML" : "Scala SVG")
                                    <select @bind="_svgScale">
                                        <option value="1">1×</option>
                                        <option value="1.5">1,5×</option>
                                        <option value="2">2×</option>
                                    </select>
                                </label>
                                <label>
                                    Fallback
                                    <select @bind="_svgFallback">
                                        <option value="@SvgFallbackMode.Rasterize">Rasterizza</option>
                                        <option value="@SvgFallbackMode.Omit">Ometti</option>
                                    </select>
                                </label>
                            }
                        </div>
                        @if (_previewFormat == PreviewFormat.Html)
                        {
                            <p class="render-note">Testo HTML visibile e selezionabile con font incorporati quando disponibili.</p>
                        }
                        else
                        {
                            <label class="switch-row">
                                <input type="checkbox" @bind="_includeText" />
                                <span></span>
                                Includi testo
                            </label>
                        }
                        @if (_previewFormat == PreviewFormat.Png)
                        {
                            <label class="switch-row">
                                <input type="checkbox" @bind="_transparent" />
                                <span></span>
                                Sfondo trasparente
                            </label>
                        }
                        else if (_previewFormat == PreviewFormat.Svg)
                        {
                            <label class="switch-row">
                                <input type="checkbox" @bind="_drawBounds" />
                                <span></span>
                                Mostra limiti testo e immagini
                            </label>
                        }

                        @if (_layers.Count > 0)
                        {
                            <details class="layers-box">
                                <summary>Livelli opzionali <span>@_layers.Count</span></summary>
                                @foreach (PdfOptionalContentGroup layer in _layers)
                                {
                                    <label class="layer-row">
                                        <input type="checkbox"
                                               checked="@LayerIsVisible(layer)"
                                               disabled="@layer.IsLocked"
                                               @onchange="eventArgs => SetLayerVisibility(layer.Id, eventArgs.Value)" />
                                        <span>@layer.Name</span>
                                        @if (layer.IsLocked)
                                        {
                                            <small>bloccato</small>
                                        }
                                    </label>
                                }
                            </details>
                        }

                        <button type="button" class="button primary full" @onclick="RenderPreviewAsync" disabled="@_isBusy">
                            @if (_isBusy)
                            {
                                <span class="spinner" aria-hidden="true"></span>
                            }
                            Renderizza pagina
                        </button>
                    </div>
                }
            </aside>

            <section class="viewer-panel" aria-busy="@_isBusy">
                @if (_document is null || _document.IsLocked)
                {
                    <div class="empty-state">
                        <div class="empty-art" aria-hidden="true">
                            <span class="sheet back"></span>
                            <span class="sheet front"><i></i><i></i><i></i></span>
                            <span class="lens"></span>
                        </div>
                        <p class="eyebrow">Pronto per l'analisi</p>
                        <h2>Il documento apparirà qui</h2>
                        <p>Seleziona un PDF dal pannello laterale. Il contenuto rimane sul tuo dispositivo.</p>
                    </div>
                }
                else
                {
                    <div class="viewer-toolbar">
                        <div class="page-navigation">
                            <button type="button" title="Pagina precedente" @onclick="PreviousPageAsync" disabled="@(_pageIndex == 0 || _isBusy)">←</button>
                            <label>
                                Pagina
                                <input type="number" min="1" max="@_document.Pages" value="@(_pageIndex + 1)" @onchange="JumpToPageAsync" />
                                <span>di @_document.Pages</span>
                            </label>
                            <button type="button" title="Pagina successiva" @onclick="NextPageAsync" disabled="@(_pageIndex >= _document.Pages - 1 || _isBusy)">→</button>
                        </div>
                        <div class="viewer-actions">
                            @if (_page is not null)
                            {
                                <div class="page-facts">
                                    <span>@_page.Orientation</span>
                                    <span>@FormatNumber(_pageRect.Width) × @FormatNumber(_pageRect.Height) pt</span>
                                    <span>rot. @_page.Rotation°</span>
                                </div>
                            }
                            <button type="button" class="download-action compact" @onclick="DownloadPreviewAsync" disabled="@(_previewBytes is null || _isBusy)">
                                Scarica @PreviewFormatLabel
                            </button>
                            <button type="button" class="download-action compact" @onclick="DownloadExtractedPagePdfAsync" disabled="@_isBusy">
                                Estrai PDF
                            </button>
                        </div>
                    </div>

                    <div class="canvas-area">
                        @if (_isBusy)
                        {
                            <div class="render-overlay"><span class="spinner large"></span><p>Poppler.Net sta elaborando la pagina…</p></div>
                        }
                        @if (_previewFormat == PreviewFormat.Html && _previewHtml is not null)
                        {
                            <figure class="page-preview html-preview">
                                <iframe srcdoc="@_previewHtml"
                                        style="@HtmlPreviewStyle"
                                        title="Anteprima HTML della pagina @(_pageIndex + 1)"
                                        sandbox=""></iframe>
                            </figure>
                        }
                        else if (_previewUrl is not null)
                        {
                            <figure class="page-preview @(_transparent ? "checkerboard" : null)">
                                <img src="@_previewUrl" alt="Anteprima della pagina @(_pageIndex + 1)" />
                            </figure>
                        }
                        else
                        {
                            <div class="preview-placeholder">Anteprima non disponibile</div>
                        }
                    </div>
                }
            </section>
        </section>

        @if (_document is not null && !_document.IsLocked && _page is not null)
        {
            <section class="inspector">
                <div class="inspector-heading">
                    <div>
                        <p class="step">03 · Ispezione</p>
                        <h2>Dentro la pagina @(_pageIndex + 1)</h2>
                    </div>
                    <span class="api-chip">Poppler.Page</span>
                </div>

                <div class="tabs" role="tablist" aria-label="Dati del documento">
                    @foreach (InspectorTab tab in Enum.GetValues<InspectorTab>())
                    {
                        int? count = TabCount(tab);
                        <button type="button" role="tab" aria-selected="@(_activeTab == tab)" class="@(_activeTab == tab ? "active" : null)" @onclick="() => _activeTab = tab">
                            @TabLabel(tab)
                            @if (count.HasValue)
                            {
                                <small>@count.Value</small>
                            }
                        </button>
                    }
                </div>

                <div class="tab-content" role="tabpanel">
                    @switch (_activeTab)
                    {
                        case InspectorTab.Overview:
                            <div class="overview-grid">
                                <article class="metric-card"><span>Pagine</span><strong>@_document.Pages</strong><small>etichetta corrente: @_page.Label</small></article>
                                <article class="metric-card"><span>Blocchi testo</span><strong>@_textBoxesCount</strong><small>@_pageText.Length caratteri estratti</small></article>
                                <article class="metric-card"><span>Risorse</span><strong>@(_fonts.Count + _images.Count)</strong><small>@_fonts.Count font · @_images.Count immagini</small></article>
                                <article class="metric-card"><span>Interattività</span><strong>@(_annotations.Count + _formWidgetsCount)</strong><small>@_annotations.Count annotazioni · @_formWidgetsCount widget</small></article>
                            </div>
                            <div class="capability-grid">
                                <div><span class="cap-icon">T</span><strong>Estrazione testo</strong><small>Ordine fisico e ricerca</small></div>
                                <div><span class="cap-icon">Aa</span><strong>Analisi font</strong><small>Embedding, encoding e mapping Unicode</small></div>
                                <div><span class="cap-icon">◫</span><strong>Immagini</strong><small>Decodifica e conversione PNG</small></div>
                                <div><span class="cap-icon">⌁</span><strong>Struttura PDF</strong><small>Outline, livelli, form e allegati</small></div>
                            </div>
                            <section class="export-panel" aria-label="Esporta documento e pagina">
                                <div class="export-copy">
                                    <span class="cap-icon">↓</span>
                                    <div><strong>Esporta i risultati</strong><small>HTML e PDF autonomi generati localmente, senza upload.</small></div>
                                </div>
                                <div class="export-actions">
                                    <button type="button" class="download-action" @onclick="DownloadSourcePdfAsync" disabled="@(_selectedBytes is null || _isBusy)">PDF originale</button>
                                    <button type="button" class="download-action" @onclick="DownloadExtractedPagePdfAsync" disabled="@_isBusy">Pagina PDF autonoma</button>
                                    <button type="button" class="download-action" @onclick="DownloadExtractedPagesZipAsync" disabled="@_isBusy">Pagine PDF .zip</button>
                                    <button type="button" class="download-action" @onclick="DownloadPreviewAsync" disabled="@(_previewBytes is null || _isBusy)">Anteprima @PreviewFormatLabel</button>
                                    <button type="button" class="download-action" @onclick="DownloadPageHtmlAsync" disabled="@_isBusy">Pagina HTML</button>
                                    <button type="button" class="download-action" @onclick="DownloadDocumentHtmlAsync" disabled="@_isBusy">Documento HTML</button>
                                    <button type="button" class="download-action" @onclick="DownloadHtmlBundleAsync" disabled="@_isBusy">Bundle HTML .zip</button>
                                    <button type="button" class="download-action" @onclick="DownloadDocumentTextAsync" disabled="@_isBusy">Testo completo</button>
                                    <button type="button" class="download-action" @onclick="DownloadMetadataAsync" disabled="@_isBusy">Metadati JSON</button>
                                </div>
                            </section>
                            break;

                        case InspectorTab.Text:
                            <div class="text-tools">
                                <div class="search-box">
                                    <input type="search" placeholder="Cerca nella pagina…" @bind="_searchText" @bind:event="oninput" @onkeydown="SearchOnEnterAsync" />
                                    <button type="button" @onclick="SearchPage">Cerca</button>
                                </div>
                                <div class="inline-actions">
                                    @if (_searchText.Length > 0)
                                    {
                                        <span class="search-result">@_searchHits.Count occorrenze</span>
                                    }
                                    <button type="button" class="download-action compact" @onclick="DownloadPageTextAsync" disabled="@(string.IsNullOrEmpty(_pageText) || _isBusy)">Pagina .txt</button>
                                    <button type="button" class="download-action compact" @onclick="DownloadDocumentTextAsync" disabled="@_isBusy">Documento .txt</button>
                                </div>
                            </div>
                            @if (string.IsNullOrEmpty(_pageText))
                            {
                                <EmptyResult Icon="T" Title="Nessun testo estratto" Description="La pagina potrebbe contenere solo immagini o tracciati." />
                            }
                            else
                            {
                                <pre class="text-output">@_pageText</pre>
                            }
                            break;

                        case InspectorTab.Fonts:
                            @if (_fonts.Count == 0)
                            {
                                <EmptyResult Icon="Aa" Title="Nessun font rilevato" Description="Questa pagina non usa risorse font." />
                            }
                            else
                            {
                                <div class="section-toolbar">
                                    <p class="result-note">I programmi font sono disponibili solo quando incorporati nel PDF.</p>
                                    <button type="button" class="download-action compact" @onclick="DownloadFontsZipAsync" disabled="@(!_fonts.Any(font => font.GetEmbeddedData().Length > 0) || _isBusy)">Font incorporati .zip</button>
                                </div>
                                <div class="table-wrap"><table>
                                    <thead><tr><th>Risorsa</th><th>Nome</th><th>Tipo</th><th>Encoding</th><th>Incorporato</th><th>ToUnicode</th><th>Download</th></tr></thead>
                                    <tbody>
                                    @foreach (FontInfo font in _fonts)
                                    {
                                        <tr>
                                            <td><code>@font.ResourceName</code></td>
                                            <td>
                                                <strong>@font.Name</strong>
                                                @if (font.IsSubset)
                                                {
                                                    <small class="line-note">subset</small>
                                                }
                                            </td>
                                            <td>@font.Type</td>
                                            <td>@font.Encoding</td>
                                            <td><StatusBadge Enabled="font.IsEmbedded" TrueText="Sì" FalseText="No" /></td>
                                            <td><StatusBadge Enabled="font.HasToUnicode" TrueText="Sì" FalseText="No" /></td>
                                            <td>
                                                @if (font.GetEmbeddedData().Length > 0)
                                                {
                                                    <button type="button" class="download-action compact" @onclick="() => DownloadFontAsync(font)" disabled="@_isBusy">Scarica</button>
                                                }
                                                else
                                                {
                                                    <span class="muted">—</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table></div>
                            }
                            break;

                        case InspectorTab.Images:
                            @if (_images.Count == 0)
                            {
                                <EmptyResult Icon="◫" Title="Nessuna immagine rilevata" Description="La pagina potrebbe essere composta solo da testo e grafica vettoriale." />
                            }
                            else
                            {
                                <div class="section-toolbar">
                                    <p class="result-note">Le immagini sono esportate come PNG decodificati.</p>
                                    <button type="button" class="download-action compact" @onclick="DownloadImagesZipAsync" disabled="@_isBusy">Tutte le immagini .zip</button>
                                </div>
                                <div class="image-grid">
                                    @foreach (ImagePreview image in _imagePreviews)
                                    {
                                        <article class="image-card">
                                            <div class="image-thumb checkerboard">
                                                @if (image.DataUrl is not null)
                                                {
                                                    <img src="@image.DataUrl" alt="Risorsa @image.Source.ResourceName" />
                                                }
                                                else
                                                {
                                                    <span>Anteprima non disponibile</span>
                                                }
                                            </div>
                                            <div class="image-card-footer">
                                                <span><strong>@image.Source.ResourceName</strong><small>@image.Source.Width × @image.Source.Height px · @image.Source.Compression</small></span>
                                                <button type="button" class="download-action compact" @onclick="() => DownloadImageAsync(image)" disabled="@_isBusy">PNG</button>
                                            </div>
                                        </article>
                                    }
                                </div>
                                @if (_images.Count > _imagePreviews.Count)
                                {
                                    <p class="result-note">Mostrate le prime @_imagePreviews.Count di @_images.Count immagini.</p>
                                }
                            }
                            break;

                        case InspectorTab.Annotations:
                            @if (_annotations.Count == 0)
                            {
                                <EmptyResult Icon="⌁" Title="Nessuna annotazione" Description="Non sono presenti link, note o altre annotazioni sulla pagina." />
                            }
                            else
                            {
                                <div class="table-wrap"><table>
                                    <thead><tr><th>Tipo</th><th>Contenuto</th><th>Rettangolo</th><th>Azione</th><th>Visibile</th><th>Allegato</th></tr></thead>
                                    <tbody>
                                    @foreach (PdfAnnotation annotation in _annotations)
                                    {
                                        <tr>
                                            <td><strong>@annotation.Type</strong><small class="line-note">@annotation.Subtype</small></td>
                                            <td class="wide-cell">@ValueOrDash(annotation.Contents)</td>
                                            <td><code>@annotation.Rectangle</code></td>
                                            <td>@annotation.Action.Type</td>
                                            <td><StatusBadge Enabled="annotation.IsVisible" TrueText="Sì" FalseText="No" /></td>
                                            <td>
                                                @if (annotation.Attachment is { } attachment)
                                                {
                                                    <button type="button" class="download-action compact" @onclick="() => DownloadAttachmentAsync(attachment)" disabled="@_isBusy">Scarica</button>
                                                }
                                                else
                                                {
                                                    <span class="muted">—</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table></div>
                            }
                            break;

                        case InspectorTab.Structure:
                            <div class="structure-grid">
                                <article>
                                    <div class="section-title"><h3>Outline</h3><span>@_outlines.Count</span></div>
                                    @if (_outlines.Count == 0)
                                    {
                                        <p class="muted">Nessun segnalibro nel documento.</p>
                                    }
                                    else
                                    {
                                        <OutlineTree Items="_outlines" PageSelected="GoToPageAsync" />
                                    }
                                </article>
                                <article>
                                    <div class="section-title"><h3>Livelli opzionali</h3><span>@_layers.Count</span></div>
                                    @if (_layers.Count == 0)
                                    {
                                        <p class="muted">Nessun Optional Content Group.</p>
                                    }
                                    else
                                    {
                                        <ul class="detail-list">
                                            @foreach (PdfOptionalContentGroup layer in _layers)
                                            {
                                                <li><span><strong>@layer.Name</strong><small>@string.Join(", ", layer.Intents)</small></span><StatusBadge Enabled="LayerIsVisible(layer)" TrueText="Visibile" FalseText="Nascosto" /></li>
                                            }
                                        </ul>
                                    }
                                </article>
                                <article>
                                    <div class="section-title"><h3>Documento</h3></div>
                                    <ul class="detail-list compact">
                                        <li><span>Campi modulo</span><strong>@_formFieldsCount</strong></li>
                                        <li><span>Allegati</span><strong>@_embeddedFiles.Count</strong></li>
                                        <li><span>Destinazioni nominate</span><strong>@_namedDestinationsCount</strong></li>
                                        <li><span>JavaScript dichiarato</span><strong>@(_hasJavaScript ? "Sì" : "No")</strong></li>
                                    </ul>
                                </article>
                                @if (_embeddedFiles.Count > 0)
                                {
                                    <article class="attachments-card">
                                        <div class="section-title">
                                            <h3>File allegati</h3>
                                            <button type="button" class="download-action compact" @onclick="DownloadAttachmentsZipAsync" disabled="@_isBusy">Tutti .zip</button>
                                        </div>
                                        <ul class="detail-list attachment-list">
                                            @foreach (EmbeddedFile attachment in _embeddedFiles)
                                            {
                                                <li>
                                                    <span><strong>@attachment.Name</strong><small>@FormatBytes(attachment.DeclaredSize ?? attachment.Size) · @ValueOrDash(attachment.MimeType)</small></span>
                                                    <button type="button" class="download-action compact" @onclick="() => DownloadAttachmentAsync(attachment)" disabled="@_isBusy">Scarica</button>
                                                </li>
                                            }
                                        </ul>
                                    </article>
                                }
                            </div>
                            break;

                        case InspectorTab.Diagnostics:
                            <div class="section-toolbar diagnostics-toolbar">
                                <p class="result-note">Esporta le segnalazioni raccolte durante l'apertura e il rendering.</p>
                                <button type="button" class="download-action compact" @onclick="DownloadDiagnosticsAsync" disabled="@_isBusy">Diagnostica JSON</button>
                            </div>
                            @if (_diagnostics.Count == 0)
                            {
                                <EmptyResult Icon="✓" Title="Nessuna diagnostica" Description="Il documento è stato interpretato senza segnalazioni." />
                            }
                            else
                            {
                                <ul class="diagnostic-list">
                                    @foreach (PdfDiagnostic diagnostic in _diagnostics)
                                    {
                                        long? offset = diagnostic.Offset;
                                        <li class="@diagnostic.Severity.ToString().ToLowerInvariant()">
                                            <span class="diag-level">@diagnostic.Severity</span>
                                            <div><strong>@diagnostic.Code</strong><p>@diagnostic.Message</p></div>
                                            @if (offset.HasValue)
                                            {
                                                <code>@@ @offset.Value</code>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                            break;
                    }
                </div>
            </section>
        }
    </main>

    <footer>
        <span>Poppler.Net @Document.PortVersion · upstream @Document.UpstreamVersion</span>
        <span>Blazor WebAssembly · .NET 10</span>
    </footer>
</div>

@code {
    private const long MaxInputBytes = 64 * 1024 * 1024;
    private const int MaxImagePreviews = 12;
    private static readonly string[] FallbackFontFiles =
    {
        "DejaVuSans.ttf",
        "DejaVuSans-Bold.ttf",
        "DejaVuSans-Oblique.ttf",
        "DejaVuSans-BoldOblique.ttf"
    };

    private readonly Dictionary<string, bool> _layerVisibility = new(StringComparer.Ordinal);
    private byte[]? _selectedBytes;
    private Document? _document;
    private Page? _page;
    private string? _fileName;
    private long _fileSize;
    private string _ownerPassword = "";
    private string _userPassword = "";
    private string? _errorMessage;
    private string? _previewUrl;
    private string? _previewHtml;
    private byte[]? _previewBytes;
    private string _previewExtension = "html";
    private string _previewMimeType = "text/html;charset=utf-8";
    private string _pageText = "";
    private string _searchText = "";
    private bool _isBusy;
    private bool _includeText = true;
    private bool _transparent;
    private bool _drawBounds;
    private bool _hasJavaScript;
    private int _pageIndex;
    private int _antialiasing = 2;
    private int _textBoxesCount;
    private int _formWidgetsCount;
    private int _formFieldsCount;
    private int _namedDestinationsCount;
    private double _dpi = 96;
    private double _svgScale = 1;
    private PdfRectangle _pageRect;
    private PreviewFormat _previewFormat = PreviewFormat.Html;
    private SvgFallbackMode _svgFallback = SvgFallbackMode.Rasterize;
    private InspectorTab _activeTab;
    private IReadOnlyList<PdfRectangle> _searchHits = Array.Empty<PdfRectangle>();
    private IReadOnlyList<FontInfo> _fonts = Array.Empty<FontInfo>();
    private IReadOnlyList<PdfImage> _images = Array.Empty<PdfImage>();
    private IReadOnlyList<ImagePreview> _imagePreviews = Array.Empty<ImagePreview>();
    private IReadOnlyList<EmbeddedFile> _embeddedFiles = Array.Empty<EmbeddedFile>();
    private IReadOnlyList<PdfAnnotation> _annotations = Array.Empty<PdfAnnotation>();
    private IReadOnlyList<PdfOutlineItem> _outlines = Array.Empty<PdfOutlineItem>();
    private IReadOnlyList<PdfOptionalContentGroup> _layers = Array.Empty<PdfOptionalContentGroup>();
    private IReadOnlyList<PdfDiagnostic> _diagnostics = Array.Empty<PdfDiagnostic>();
    private Task<string>? _fallbackFontsTask;

    private string DisplayTitle =>
        !string.IsNullOrWhiteSpace(_document?.Title) ? _document.Title : _fileName ?? "Documento PDF";

    private string PreviewFormatLabel => _previewFormat switch
    {
        PreviewFormat.Html => "HTML",
        PreviewFormat.Png => "PNG",
        PreviewFormat.Svg => "SVG",
        _ => _previewFormat.ToString().ToUpperInvariant()
    };

    private string HtmlPreviewStyle
    {
        get
        {
            if (_page is null)
                return "";

            PdfRectangle crop = _page.PageRect(PageBox.CropBox);
            double width = crop.Width * _svgScale;
            double height = crop.Height * _svgScale;
            int rotation = ((_page.Rotation % 360) + 360) % 360;
            if (rotation is 90 or 270)
                (width, height) = (height, width);
            return $"width:{FormatNumber(width)}px;height:{FormatNumber(height)}px";
        }
    }

    private async Task HandleFileAsync(InputFileChangeEventArgs eventArgs)
    {
        _errorMessage = null;
        _isBusy = true;
        IBrowserFile file = eventArgs.File;
        _fileName = file.Name;
        _fileSize = file.Size;
        try
        {
            await using Stream input = file.OpenReadStream(MaxInputBytes);
            using var output = new MemoryStream((int)Math.Min(file.Size, int.MaxValue));
            await input.CopyToAsync(output);
            _selectedBytes = output.ToArray();
            await LoadDocumentAsync();
        }
        catch (Exception exception)
        {
            ResetDocument();
            _errorMessage = FriendlyMessage(exception);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task LoadSampleAsync()
    {
        _errorMessage = null;
        _isBusy = true;
        try
        {
            _selectedBytes = await Http.GetByteArrayAsync("samples/playground-demo.pdf");
            _fileName = "playground-demo.pdf";
            _fileSize = _selectedBytes.LongLength;
            _ownerPassword = "";
            _userPassword = "";
            await LoadDocumentAsync();
        }
        catch (Exception exception)
        {
            ResetDocument();
            _errorMessage = FriendlyMessage(exception);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ReloadDocumentAsync()
    {
        if (_selectedBytes is null)
            return;

        _errorMessage = null;
        _isBusy = true;
        try
        {
            await LoadDocumentAsync();
        }
        catch (Exception exception)
        {
            ResetDocument();
            _errorMessage = FriendlyMessage(exception);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task LoadDocumentAsync()
    {
        await Task.Yield();
        _document?.Dispose();
        _document = Document.LoadFromData(
            _selectedBytes!,
            ownerPassword: _ownerPassword,
            userPassword: _userPassword);
        _pageIndex = 0;
        _previewUrl = null;
        _previewHtml = null;
        _layerVisibility.Clear();

        if (_document.IsLocked)
        {
            ClearPageState();
            return;
        }

        _outlines = _document.OutlineItems;
        _layers = _document.OptionalContentGroups;
        foreach (PdfOptionalContentGroup layer in _layers)
            _layerVisibility[layer.Id] = layer.IsVisible;
        _formFieldsCount = _document.FormFields.Count;
        _embeddedFiles = _document.EmbeddedFiles;
        _namedDestinationsCount = _document.NamedDestinations.Count;
        _hasJavaScript = _document.HasJavaScript;

        await RefreshPageAsync();
    }

    private async Task RefreshPageAsync()
    {
        if (_document is null || _document.IsLocked || _document.Pages == 0)
            return;

        _isBusy = true;
        _errorMessage = null;
        try
        {
            await Task.Yield();
            _page = _document.CreatePage(_pageIndex);
            _pageRect = _page.PageRect();
            _pageText = _page.Text();
            _textBoxesCount = _page.TextList().Count;
            _fonts = _page.Fonts;
            _images = _page.Images;
            _annotations = _page.Annotations;
            _formWidgetsCount = _page.FormWidgets.Count;
            _imagePreviews = _images
                .Take(MaxImagePreviews)
                .Select((image, index) => new ImagePreview(
                    image,
                    index,
                    TryCreatePngDataUrl(image)))
                .ToArray();
            _searchText = "";
            _searchHits = Array.Empty<PdfRectangle>();
            await RenderPreviewCoreAsync();
            _diagnostics = _document.Diagnostics.ToArray();
        }
        catch (Exception exception)
        {
            _previewUrl = null;
            _previewHtml = null;
            _previewBytes = null;
            _errorMessage = FriendlyMessage(exception);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task RenderPreviewAsync()
    {
        if (_page is null)
            return;

        _isBusy = true;
        _errorMessage = null;
        try
        {
            await RenderPreviewCoreAsync();
            _diagnostics = _document?.Diagnostics.ToArray() ?? Array.Empty<PdfDiagnostic>();
        }
        catch (Exception exception)
        {
            _errorMessage = FriendlyMessage(exception);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task RenderPreviewCoreAsync()
    {
        await Task.Yield();
        IReadOnlyDictionary<string, bool> visibility = new Dictionary<string, bool>(_layerVisibility, StringComparer.Ordinal);
        _previewUrl = null;
        _previewHtml = null;
        _previewBytes = null;

        if (_previewFormat == PreviewFormat.Html)
        {
            string html = _page!.RenderToHtml(HtmlPageOptions());
            byte[] htmlBytes = Encoding.UTF8.GetBytes(html);
            _previewHtml = html;
            _previewBytes = htmlBytes;
            _previewExtension = "html";
            _previewMimeType = "text/html;charset=utf-8";
        }
        else if (_previewFormat == PreviewFormat.Png)
        {
            IReadOnlyList<string> fontDirectories =
                _includeText && _fonts.Any(font => !font.IsEmbedded)
                    ? new[] { await EnsureFallbackFontsAsync() }
                    : Array.Empty<string>();
            byte[] png = _page!.RenderToPng(new RasterRenderOptions
            {
                Dpi = _dpi,
                Antialiasing = _antialiasing,
                Transparent = _transparent,
                IncludeText = _includeText,
                UseFontSubstitution = true,
                FontDirectories = fontDirectories,
                OptionalContentVisibility = visibility
            });
            _previewBytes = png;
            _previewExtension = "png";
            _previewMimeType = "image/png";
            _previewUrl = $"data:image/png;base64,{Convert.ToBase64String(png)}";
        }
        else
        {
            string svg = _page!.RenderToSvg(new SvgRenderOptions
            {
                Scale = _svgScale,
                IncludeText = _includeText,
                DrawTextBounds = _drawBounds,
                DrawImageBounds = _drawBounds,
                FallbackMode = _svgFallback,
                OptionalContentVisibility = visibility
            });
            byte[] svgBytes = Encoding.UTF8.GetBytes(svg);
            _previewBytes = svgBytes;
            _previewExtension = "svg";
            _previewMimeType = "image/svg+xml";
            _previewUrl = $"data:image/svg+xml;base64,{Convert.ToBase64String(svgBytes)}";
        }
    }

    private async Task<string> EnsureFallbackFontsAsync()
    {
        Task<string> loadTask = _fallbackFontsTask ??= LoadFallbackFontsAsync();
        try
        {
            return await loadTask;
        }
        catch
        {
            if (ReferenceEquals(_fallbackFontsTask, loadTask))
                _fallbackFontsTask = null;
            throw;
        }
    }

    private async Task<string> LoadFallbackFontsAsync()
    {
        string directory = Path.Combine(
            Path.GetTempPath(),
            "poppler-net-playground",
            "fonts",
            "dejavu-2.37");
        Directory.CreateDirectory(directory);

        Task<byte[]>[] downloads = FallbackFontFiles
            .Select(fileName => Http.GetByteArrayAsync($"fonts/{fileName}"))
            .ToArray();
        byte[][] fontData = await Task.WhenAll(downloads);
        for (int index = 0; index < FallbackFontFiles.Length; index++)
        {
            string path = Path.Combine(directory, FallbackFontFiles[index]);
            File.WriteAllBytes(path, fontData[index]);
        }

        return directory;
    }

    private async Task SetPreviewFormatAsync(PreviewFormat format)
    {
        if (_previewFormat == format)
            return;
        _previewFormat = format;
        await RenderPreviewAsync();
    }

    private async Task PreviousPageAsync() => await GoToPageAsync(_pageIndex - 1);
    private async Task NextPageAsync() => await GoToPageAsync(_pageIndex + 1);

    private async Task JumpToPageAsync(ChangeEventArgs eventArgs)
    {
        if (int.TryParse(eventArgs.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int number))
            await GoToPageAsync(number - 1);
    }

    private async Task GoToPageAsync(int pageIndex)
    {
        if (_document is null || pageIndex < 0 || pageIndex >= _document.Pages || pageIndex == _pageIndex)
            return;
        _pageIndex = pageIndex;
        await RefreshPageAsync();
    }

    private void SearchPage()
    {
        _searchHits = _page is not null && !string.IsNullOrWhiteSpace(_searchText)
            ? _page.Search(_searchText)
            : Array.Empty<PdfRectangle>();
    }

    private Task SearchOnEnterAsync(KeyboardEventArgs eventArgs)
    {
        if (eventArgs.Key == "Enter")
            SearchPage();
        return Task.CompletedTask;
    }

    private void SetLayerVisibility(string id, object? value)
    {
        _layerVisibility[id] = value is bool enabled && enabled;
    }

    private bool LayerIsVisible(PdfOptionalContentGroup layer) =>
        _layerVisibility.TryGetValue(layer.Id, out bool visible) ? visible : layer.IsVisible;

    private Task DownloadSourcePdfAsync()
    {
        return RunDownloadAsync(() =>
        {
            byte[] data = _selectedBytes ?? throw new InvalidOperationException("Nessun PDF caricato.");
            return new DownloadArtifact(SafeFileName(_fileName, "document.pdf"), "application/pdf", data);
        });
    }

    private Task DownloadPreviewAsync()
    {
        return RunDownloadAsync(() =>
        {
            byte[] data = _previewBytes ?? throw new InvalidOperationException("Nessuna anteprima disponibile.");
            return new DownloadArtifact(
                $"{DocumentStem}-pagina-{_pageIndex + 1}.{_previewExtension}",
                _previewMimeType,
                data);
        });
