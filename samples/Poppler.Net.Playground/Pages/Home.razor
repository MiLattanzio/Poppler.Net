    private Task DownloadPageTextAsync() => RunDownloadAsync(() =>
        new DownloadArtifact(
            $"{DocumentStem}-pagina-{_pageIndex + 1}.txt",
            "text/plain;charset=utf-8",
            Encoding.UTF8.GetBytes(_pageText)));

    private Task DownloadDocumentTextAsync()
    {
        return RunDownloadAsync(() =>
        {
            Document document = _document ?? throw new InvalidOperationException("Nessun PDF caricato.");
            var text = new StringBuilder();
            for (int index = 0; index < document.Pages; index++)
            {
                Page page = document.CreatePage(index);
                if (index > 0)
                    text.AppendLine().AppendLine();
                text.Append("=== Pagina ").Append(index + 1);
                if (!string.IsNullOrWhiteSpace(page.Label))
                    text.Append(" (").Append(page.Label).Append(')');
                text.AppendLine(" ===").Append(page.Text());
            }

            return new DownloadArtifact(
                $"{DocumentStem}-testo.txt",
                "text/plain;charset=utf-8",
                Encoding.UTF8.GetBytes(text.ToString()));
        });
    }

    private Task DownloadMetadataAsync()
    {
        return RunDownloadAsync(() =>
        {
            Document document = _document ?? throw new InvalidOperationException("Nessun PDF caricato.");
