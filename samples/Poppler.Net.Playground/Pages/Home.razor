    private Task DownloadAttachmentAsync(EmbeddedFile attachment) => RunDownloadAsync(() =>
        new DownloadArtifact(
            SafeFileName(attachment.Name, "allegato.bin"),
            string.IsNullOrWhiteSpace(attachment.MimeType) ? "application/octet-stream" : attachment.MimeType,
            attachment.Data.ToArray()));

    private Task DownloadAttachmentsZipAsync()
    {
        return RunDownloadAsync(() =>
        {
            IEnumerable<ZipItem> items = _embeddedFiles.Select((attachment, index) =>
                new ZipItem(
                    SafeFileName(attachment.Name, $"allegato-{index + 1}.bin"),
                    attachment.Data.ToArray()));
            return new DownloadArtifact(
                $"{DocumentStem}-allegati.zip",
