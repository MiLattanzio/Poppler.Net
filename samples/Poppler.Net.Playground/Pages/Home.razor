    private Task DownloadDocumentHtmlAsync()
    {
        return RunDownloadAsync(() =>
        {
            Document document = _document ?? throw new InvalidOperationException("Nessun PDF caricato.");
            string html = document.RenderToHtml(new HtmlExportOptions
            {
                Title = DisplayTitle,
