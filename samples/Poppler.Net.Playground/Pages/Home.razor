                    document.Keywords,
                    document.Creator,
                    document.Producer,
                    document.CreationDate,
                    document.ModificationDate,
                    document.IsLinearized,
                    document.IsEncrypted,
                    passwordKind = document.PasswordKind.ToString(),
                    pageMode = document.PageMode.ToString(),
                    pageLayout = document.PageLayout.ToString(),
                    information = document.Information,
                    xmpMetadata = document.Metadata,
                    embeddedFiles = _embeddedFiles.Select(file => new
                    {
                        file.Name,
                        file.Description,
                        file.MimeType,
                        file.DeclaredSize,
                        actualSize = file.Size,
                        file.CreationDate,
                        file.ModificationDate
                    })
                },
                currentPage = new
                {
                    number = _pageIndex + 1,
                    label = _page?.Label,
                    widthPoints = _pageRect.Width,
