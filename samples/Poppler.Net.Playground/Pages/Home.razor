    private async Task RunDownloadAsync(Func<DownloadArtifact> createArtifact)
    {
        _errorMessage = null;
        _isBusy = true;
        try
        {
            await Task.Yield();
            DownloadArtifact artifact = createArtifact();
            using var stream = new MemoryStream(artifact.Data, writable: false);
            using var streamReference = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync(
                "popplerNetDownloads.save",
                SafeFileName(artifact.FileName, "download.bin"),
                artifact.MimeType,
                streamReference);
        }
        catch (Exception exception)
        {
            _errorMessage = FriendlyMessage(exception);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private string DocumentStem
    {
        get
        {
            string fileName = SafeFileName(_fileName, "document.pdf");
            string stem = Path.GetFileNameWithoutExtension(fileName);
            return SafeFileName(stem, "document");
        }
    }

    private string ImageFileName(PdfImage image, int index)
    {
        string resource = SafeFileName(image.ResourceName, $"immagine-{index + 1}");
        return $"{DocumentStem}-pagina-{_pageIndex + 1}-{resource}.png";
    }

    private string ExtractedPageFileName(int pageNumber)
    {
        int width = Math.Max(4, (_document?.Pages ?? pageNumber)
            .ToString(CultureInfo.InvariantCulture)
            .Length);
        return $"{DocumentStem}-pagina-{pageNumber.ToString("D" + width, CultureInfo.InvariantCulture)}.pdf";
    }

    private HtmlRenderOptions HtmlPageOptions() => new()
    {
        Scale = _svgScale,
        TextLayerMode = HtmlTextLayerMode.Visible,
        EmbedFonts = true,
        FallbackMode = _svgFallback,
        RasterFallbackDpi = Math.Clamp(_dpi, 1, 2400),
        OptionalContentVisibility = new Dictionary<string, bool>(
            _layerVisibility,
            StringComparer.Ordinal)
    };

    private static FontDownload FontDownloadFor(FontInfo font)
    {
        (string extension, string mimeType) = font.EmbeddedFormat switch
        {
            EmbeddedFontFormat.Type1 => ("pfb", "application/x-font-type1"),
            EmbeddedFontFormat.Cff => ("cff", "application/octet-stream"),
            EmbeddedFontFormat.TrueType => ("ttf", "font/ttf"),
            EmbeddedFontFormat.OpenType => ("otf", "font/otf"),
            _ => ("bin", "application/octet-stream")
        };
        string name = SafeFileName(font.Name, SafeFileName(font.ResourceName, "font"));
        return new FontDownload($"{name}.{extension}", mimeType);
    }

    private static byte[] CreateZip(IEnumerable<ZipItem> items)
    {
        using var output = new MemoryStream();
        using (var archive = new ZipArchive(output, ZipArchiveMode.Create, leaveOpen: true))
        {
            var usedNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (ZipItem item in items)
            {
                string name = UniqueZipName(SafeFileName(item.Name, "file.bin"), usedNames);
                ZipArchiveEntry entry = archive.CreateEntry(name, CompressionLevel.Fastest);
                using Stream destination = entry.Open();
                destination.Write(item.Data);
            }
        }
        return output.ToArray();
    }

    private static byte[] CreateBundleZip(HtmlExportBundle bundle)
    {
        using var output = new MemoryStream();
        using (var archive = new ZipArchive(output, ZipArchiveMode.Create, leaveOpen: true))
        {
            foreach (HtmlExportFile file in bundle.Files)
            {
                ZipArchiveEntry entry = archive.CreateEntry(
                    file.RelativePath,
                    CompressionLevel.Fastest);
                using Stream destination = entry.Open();
                destination.Write(file.Data.Span);
            }
        }
        return output.ToArray();
    }

    private static string UniqueZipName(string name, HashSet<string> usedNames)
    {
        if (usedNames.Add(name))
            return name;

        string extension = Path.GetExtension(name);
        string stem = Path.GetFileNameWithoutExtension(name);
        for (int suffix = 2; ; suffix++)
        {
            string candidate = $"{stem}-{suffix}{extension}";
            if (usedNames.Add(candidate))
                return candidate;
        }
    }

    private static string SafeFileName(string? candidate, string fallback)
    {
        string value = string.IsNullOrWhiteSpace(candidate) ? fallback : candidate.Trim();
        value = value.Replace('\\', '/');
        value = value[(value.LastIndexOf('/') + 1)..];

        var sanitized = new StringBuilder(value.Length);
        foreach (char character in value)
        {
            sanitized.Append(char.IsControl(character) || character is '<' or '>' or ':' or '"' or '/' or '\\' or '|' or '?' or '*'
                ? '-'
                : character);
        }

        string result = sanitized.ToString().Trim(' ', '.');
        if (string.IsNullOrWhiteSpace(result))
            result = fallback;
        return result.Length <= 140 ? result : result[..140].TrimEnd(' ', '.');
    }

    private int? TabCount(InspectorTab tab) => tab switch
    {
        InspectorTab.Text => _textBoxesCount,
        InspectorTab.Fonts => _fonts.Count,
        InspectorTab.Images => _images.Count,
        InspectorTab.Annotations => _annotations.Count,
        InspectorTab.Structure => _outlines.Count + _layers.Count,
        InspectorTab.Diagnostics => _diagnostics.Count,
        _ => null
    };

    private static string TabLabel(InspectorTab tab) => tab switch
    {
        InspectorTab.Overview => "Panoramica",
        InspectorTab.Text => "Testo",
        InspectorTab.Fonts => "Font",
        InspectorTab.Images => "Immagini",
        InspectorTab.Annotations => "Annotazioni",
        InspectorTab.Structure => "Struttura",
        InspectorTab.Diagnostics => "Diagnostica",
        _ => tab.ToString()
    };

    private void ResetDocument()
    {
        _document?.Dispose();
        _document = null;
        _previewUrl = null;
        _previewHtml = null;
        _previewBytes = null;
        ClearPageState();
    }

    private void ClearPageState()
    {
        _page = null;
        _pageText = "";
        _fonts = Array.Empty<FontInfo>();
        _images = Array.Empty<PdfImage>();
        _imagePreviews = Array.Empty<ImagePreview>();
        _embeddedFiles = Array.Empty<EmbeddedFile>();
        _annotations = Array.Empty<PdfAnnotation>();
        _outlines = Array.Empty<PdfOutlineItem>();
        _layers = Array.Empty<PdfOptionalContentGroup>();
        _diagnostics = _document?.Diagnostics.ToArray() ?? Array.Empty<PdfDiagnostic>();
    }

    private static string? TryCreatePngDataUrl(PdfImage image)
    {
        try
        {
            return $"data:image/png;base64,{Convert.ToBase64String(image.ToPngBytes())}";
        }
        catch
        {
            return null;
        }
    }

    private static string FriendlyMessage(Exception exception) => exception switch
    {
        IOException => "Il file non può essere letto o supera il limite consentito.",
        PdfEncryptedException => "La password non è valida oppure il documento è ancora bloccato.",
        PdfLimitException => exception.Message,
        _ => exception.Message
    };

    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string FormatNumber(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);

    private static string FormatBytes(long bytes) => bytes switch
    {
        >= 1024L * 1024L => $"{bytes / (1024d * 1024d):0.#} MB",
        >= 1024L => $"{bytes / 1024d:0.#} KB",
        _ => $"{bytes} B"
    };

    public void Dispose() => _document?.Dispose();

    private enum PreviewFormat { Html, Png, Svg }
    private enum InspectorTab { Overview, Text, Fonts, Images, Annotations, Structure, Diagnostics }
    private sealed record ImagePreview(PdfImage Source, int Index, string? DataUrl);
    private sealed record DownloadArtifact(string FileName, string MimeType, byte[] Data);
    private sealed record FontDownload(string FileName, string MimeType);
    private sealed record ZipItem(string Name, byte[] Data);
}
