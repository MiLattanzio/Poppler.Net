    private Task DownloadFontAsync(FontInfo font)
    {
        return RunDownloadAsync(() =>
        {
            FontDownload download = FontDownloadFor(font);
            return new DownloadArtifact(download.FileName, download.MimeType, font.GetEmbeddedData().ToArray());
        });
    }

    private Task DownloadFontsZipAsync()
    {
        return RunDownloadAsync(() =>
        {
            IEnumerable<ZipItem> items = _fonts
                .Where(font => font.GetEmbeddedData().Length > 0)
                .Select(font =>
                {
                    FontDownload download = FontDownloadFor(font);
                    return new ZipItem(download.FileName, font.GetEmbeddedData().ToArray());
                });
            return new DownloadArtifact(
                $"{DocumentStem}-pagina-{_pageIndex + 1}-font.zip",
