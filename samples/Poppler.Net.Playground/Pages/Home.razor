            Page page = _page ?? throw new InvalidOperationException("Nessuna pagina disponibile.");
            string html = page.RenderToHtml(HtmlPageOptions());
            return new DownloadArtifact(
                $"{DocumentStem}-pagina-{_pageIndex + 1}.html",
                "text/html;charset=utf-8",
                Encoding.UTF8.GetBytes(html));
        });
