<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Poppler.Net\Poppler.Net.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\fixtures\*.pdf"
          Link="Fixtures\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\encrypted-fixtures.json"
          Link="Fixtures\encrypted-fixtures.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
