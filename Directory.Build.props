<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>embedded</DebugType>
    <Authors>Poppler contributors; Poppler.Net port contributors</Authors>
    <Copyright>Copyright the Poppler and Poppler.Net contributors</Copyright>
    <PackageLicenseExpression>GPL-2.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://gitlab.freedesktop.org/poppler/poppler</RepositoryUrl>
  </PropertyGroup>
</Project>
