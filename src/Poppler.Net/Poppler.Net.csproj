<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Poppler.Net</AssemblyName>
    <RootNamespace>Poppler</RootNamespace>
    <Version>0.9.0</Version>
    <AssemblyVersion>26.7.0.0</AssemblyVersion>
    <FileVersion>26.7.0.0</FileVersion>
    <Description>Managed-only port of the Poppler 26.07.0 PDF engine.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CoreJ2K" />
    <PackageReference Include="JBig2Decoder.NETStandard" />
    <PackageReference Include="StbImageSharp" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" Link="README.md" />
    <None Include="..\..\RELEASE_NOTES.md" Pack="true" PackagePath="RELEASE_NOTES.md" Link="RELEASE_NOTES.md" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" Link="LICENSE" />
    <None Include="..\..\NOTICE.md" Pack="true" PackagePath="" Link="NOTICE.md" />
  </ItemGroup>
</Project>
