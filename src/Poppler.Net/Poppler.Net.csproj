<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <TargetFramework />
    <AssemblyName>Poppler.Net</AssemblyName>
    <RootNamespace>Poppler</RootNamespace>
    <Version>0.13.0-rc.1</Version>
    <AssemblyVersion>26.7.0.0</AssemblyVersion>
    <FileVersion>26.7.0.0</FileVersion>
    <Description>Managed-only port of the Poppler 26.07.0 PDF engine.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CoreJ2K" />
    <PackageReference Include="JBig2Decoder.NETStandard" />
    <PackageReference Include="StbImageSharp" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" Link="README.md" />
    <None Include="..\..\RELEASE_NOTES.md" Pack="true" PackagePath="RELEASE_NOTES.md" Link="RELEASE_NOTES.md" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" Link="LICENSE" />
    <None Include="..\..\NOTICE.md" Pack="true" PackagePath="" Link="NOTICE.md" />
  </ItemGroup>
  <Target Name="ValidateReleaseTag">
    <PropertyGroup>
      <ExpectedReleaseTagMatch Condition="'$(ExpectedReleaseTagMatch)' == ''">true</ExpectedReleaseTagMatch>
      <ReleaseTagMatchesVersion>false</ReleaseTagMatchesVersion>
      <ReleaseTagMatchesVersion
        Condition="'$(ReleaseTag)' == '$(Version)' or '$(ReleaseTag)' == 'v$(Version)'">true</ReleaseTagMatchesVersion>
    </PropertyGroup>
    <Error
      Condition="'$(ReleaseTag)' == ''"
      Text="ReleaseTag must be provided." />
    <Error
      Condition="'$(ExpectedReleaseTagMatch)' != 'true' and '$(ExpectedReleaseTagMatch)' != 'false'"
      Text="ExpectedReleaseTagMatch must be true or false." />
    <Error
      Condition="'$(ReleaseTagMatchesVersion)' != '$(ExpectedReleaseTagMatch)'"
      Text="Release tag '$(ReleaseTag)' match state was '$(ReleaseTagMatchesVersion)', expected '$(ExpectedReleaseTagMatch)' for package version '$(Version)'." />
    <Message
      Condition="'$(ReleaseTagMatchesVersion)' == 'true'"
      Importance="high"
      Text="Release tag '$(ReleaseTag)' matches package version '$(Version)'." />
    <Message
      Condition="'$(ReleaseTagMatchesVersion)' == 'false'"
      Importance="high"
      Text="Release tag '$(ReleaseTag)' is correctly rejected for package version '$(Version)'." />
  </Target>
</Project>
